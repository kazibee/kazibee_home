# Internal scope only: @kazibee-internal/* resolves from the Kazibee registry.
# No credentials live here. Developers keep their token in ~/.npmrc
# (//registry.kazibee.com/:_authToken=...); CI writes a job-temporary
# NPM_CONFIG_USERCONFIG that is removed before any deploy step.
@kazibee-internal:registry=https://registry.kazibee.com/
