{
  "name": "kazibee",
  "version": "1.0.0",
  "description": "A NoEgo full-stack application",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/ui/styles/tailwind.css -o ./src/ui/resources/css/app.css --minify",
    "postinstall": "node scripts/postinstall.js",
    "prebuild": "npm run build:css",
    "predev": "npm run build:css && npm run dev:migrate",
    "dev:migrate": "DATABASE_URL=${DATABASE_URL:-postgres://noego:noego_dev@localhost:5432/kazibee} proper -c proper.durable.json up && DATABASE_URL=${DATABASE_URL:-postgres://noego:noego_dev@localhost:5432/kazibee} proper -c proper.relay.json up",
    "dev": "DATABASE_URL=${DATABASE_URL:-postgres://noego:noego_dev@localhost:5432/kazibee};if [ -z \"$GOOGLE_CLIENT_ID\" ] && command -v aws >/dev/null 2>&1;then GOOGLE_CLIENT_ID=$(aws ssm get-parameter --profile kazibee --region us-east-1 --name /kazibee/dev/google/client_id --with-decryption --query Parameter.Value --output text);fi;export DATABASE_URL GOOGLE_CLIENT_ID;PORT=${PORT:-3000};lsof -ti :$PORT|xargs kill 2>/dev/null;noego dev 2>&1 | tee server.log",
    "build": "noego build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--import tsx' vitest run",
    "test:watch": "NODE_OPTIONS='--import tsx' vitest",
    "reset": "proper reset",
    "migrate": "proper -c proper.durable.json up",
    "migrate:down": "proper -c proper.durable.json down",
    "migrate:status": "proper -c proper.durable.json status",
    "mcp:dev": "noego dev --config apps/mcp/noego.config.yml",
    "mcp:build": "noego build --config apps/mcp/noego.config.yml --target cloudflare --nodejs-compat --backend-only"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@neondatabase/serverless": "^1.1.0",
    "@noego/ioc": "^0.6.1",
    "@noego/logger": "^0.0.4",
    "@noego/proper": "^0.2.1",
    "@noego/stitch": "^1.0.3",
    "@noego/trace": "^0.0.6",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "sqlstack": "^3.0.0"
  },
  "devDependencies": {
    "@noego/app": "^2.4.0",
    "@noego/dinner": "^2.2.0",
    "@noego/forge": "^2.3.0",
    "@noego/testing": "^0.4.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/cli": "^4.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.17.1",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.17.1",
    "playwright": "^1.57.0",
    "supertest": "^7.1.4",
    "svelte": "5.38",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.3.6",
    "vitest": "^4.0.17"
  },
  "license": "MIT"
}
