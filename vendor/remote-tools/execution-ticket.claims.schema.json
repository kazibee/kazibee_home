{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Claims of the compact EdDSA-signed execution ticket (typ kazibee-remote-tool+jwt). Call-ticket lifetime max 30s; jti equals the operation id for call tickets; audience is exactly one executor id. Validation fails closed on unknown kid, algorithm substitution, >30s clock skew, or any binding mismatch.","properties":{"arguments_digest":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"aud":{"pattern":"^exe_[A-Za-z0-9_-]{8,64}$","type":"string"},"deadline_at":{"format":"date-time","type":"string"},"exp":{"minimum":0,"type":"integer"},"grant_generation":{"minimum":1,"type":"integer"},"grant_id":{"pattern":"^rtg_[A-Za-z0-9_-]{8,64}$","type":"string"},"iat":{"minimum":0,"type":"integer"},"iss":{"format":"uri","maxLength":256,"type":"string"},"jti":{"pattern":"^rto_[A-Za-z0-9_-]{8,64}$","type":"string"},"manifest_digest":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"nbf":{"minimum":0,"type":"integer"},"network_policy":{"enum":["public_only","public_and_loopback"]},"oauth_client_id_hash":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"profile_digest":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"profile_id":{"const":"external_mcp_workspace"},"scopes_digest":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"sub":{"pattern":"^rts_[A-Za-z0-9_-]{8,64}$","type":"string"},"tool_name":{"maxLength":128,"minLength":1,"type":"string"},"workspace_id":{"pattern":"^wrk_[A-Za-z0-9_-]{8,64}$","type":"string"}},"required":["iss","aud","sub","jti","iat","nbf","exp","grant_id","grant_generation","oauth_client_id_hash","workspace_id","profile_id","profile_digest","manifest_digest","scopes_digest","network_policy","tool_name","arguments_digest","deadline_at"],"title":"Kazibee Remote Tool execution-ticket claims","type":"object"}
